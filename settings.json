{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillListingMaxDescChars": 200,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(git worktree add *)",
      "Bash(pnpm type-check)",
      "Bash(pnpm lint)",
      "mcp__plugin_railway_railway__get-logs",
      "mcp__plugin_railway_railway__list-deployments",
      "mcp__plugin_railway_railway__list-services",
      "mcp__plugin_railway_railway__list-projects",
      "mcp__plugin_supabase_supabase__list_projects",
      "mcp__plugin_supabase_supabase__get_project",
      "mcp__plugin_supabase_supabase__list_tables"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/dotrepo-sync.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/dotclaude-freshness.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/link-doctor.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/agent-creds-sync.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/worktree-install-check.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/claude-accounts-report.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/fleet-mode-report.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/prisma-client-freshness.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/git-guard.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/worktree-cd-guard.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/npm-install-guard.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/heredoc-guard.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/db-push-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__github-rest__pr_create",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/verify-reminder.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/pr-base-guard.sh"
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/secret-read-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/worktree-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/claim-guard.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/migration-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_serena_serena__execute_shell_command|mcp__serena__execute_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/mcp-tool-adapter.sh git-guard"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/mcp-tool-adapter.sh worktree-cd-guard"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/mcp-tool-adapter.sh npm-install-guard"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/mcp-tool-adapter.sh heredoc-guard"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/mcp-tool-adapter.sh db-push-guard"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/mcp-tool-adapter.sh verify-reminder"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/mcp-tool-adapter.sh pr-base-guard"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/mcp-tool-adapter.sh secret-read-guard"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/mcp-tool-adapter.sh worktree-guard"
          }
        ]
      },
      {
        "matcher": "Grep|mcp__plugin_serena_serena__read_file|mcp__serena__read_file|mcp__plugin_serena_serena__search_for_pattern|mcp__serena__search_for_pattern",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/mcp-tool-adapter.sh secret-read-guard"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_serena_serena__create_text_file|mcp__serena__create_text_file|mcp__plugin_serena_serena__replace_content|mcp__serena__replace_content|mcp__plugin_serena_serena__replace_in_files|mcp__serena__replace_in_files|mcp__plugin_serena_serena__delete_lines|mcp__serena__delete_lines|mcp__plugin_serena_serena__replace_lines|mcp__serena__replace_lines|mcp__plugin_serena_serena__insert_at_line|mcp__serena__insert_at_line|mcp__plugin_serena_serena__replace_symbol_body|mcp__serena__replace_symbol_body|mcp__plugin_serena_serena__insert_after_symbol|mcp__serena__insert_after_symbol|mcp__plugin_serena_serena__insert_before_symbol|mcp__serena__insert_before_symbol|mcp__plugin_serena_serena__rename_symbol|mcp__serena__rename_symbol|mcp__plugin_serena_serena__safe_delete_symbol|mcp__serena__safe_delete_symbol",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/mcp-tool-adapter.sh worktree-guard"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/mcp-tool-adapter.sh claim-guard"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/mcp-tool-adapter.sh migration-guard"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/subagent-evidence.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/worktree-bootstrap.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/credential-output-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_serena_serena__execute_shell_command|mcp__serena__execute_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/credential-output-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/tool-gap-reporter.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true,
    "railway@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "prisma@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "sentry@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "impeccable@impeccable": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "marketing-skills@marketingskills": true,
    "hyperframes@claude-plugins-official": true,
    "small-business@knowledge-work-plugins": true,
    "legal@knowledge-work-plugins": true,
    "operations@knowledge-work-plugins": true,
    "upload-post@upload-post": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    },
    "marketingskills": {
      "source": {
        "source": "github",
        "repo": "coreyhaines31/marketingskills"
      }
    },
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    },
    "upload-post": {
      "source": {
        "source": "github",
        "repo": "Upload-Post/upload-post-plugin"
      }
    }
  },
  "outputStyle": "Concise",
  "spinnerTipsEnabled": false,
  "effortLevel": "medium",
  "promptSuggestionEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "precomputeCompactionEnabled": true
}
